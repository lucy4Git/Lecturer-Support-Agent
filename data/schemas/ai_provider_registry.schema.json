{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lecturer-support-agent.local/schemas/ai_provider_registry.schema.json",
  "title": "AI Provider Registry",
  "type": "object",
  "required": [
    "registry_version",
    "policy",
    "providers"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "registry_version": {
      "type": "string"
    },
    "policy": {
      "type": "object"
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "display_name",
          "deployment_type",
          "adapter",
          "base_url_env",
          "model_discovery",
          "capability_hints"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "display_name": {
            "type": "string"
          },
          "deployment_type": {
            "enum": [
              "cloud",
              "local",
              "self_hosted"
            ]
          },
          "enabled_by_default": {
            "type": "boolean"
          },
          "api_key_env": {
            "type": [
              "string",
              "null"
            ]
          },
          "base_url_env": {
            "type": "string"
          },
          "default_model_env": {
            "type": "string"
          },
          "model_discovery": {
            "type": "string"
          },
          "adapter": {
            "type": "string"
          },
          "capability_hints": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lecturer-support-agent.example/schemas/owner-machine-validation-profile.schema.json",
  "title": "Owner Machine Validation Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_name",
    "evidence_root",
    "stop_on_failure",
    "required_services",
    "required_ollama_models",
    "validation_stages"
  ],
  "properties": {
    "profile_name": {
      "type": "string",
      "minLength": 1
    },
    "evidence_root": {
      "type": "string",
      "minLength": 1
    },
    "stop_on_failure": {
      "type": "boolean"
    },
    "required_services": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "postgresql",
        "redis",
        "minio",
        "qdrant",
        "ollama",
        "api",
        "web"
      ],
      "properties": {
        "postgresql": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "endpoint"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "endpoint": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "redis": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "endpoint"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "endpoint": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "minio": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "endpoint"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "endpoint": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "qdrant": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "endpoint"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "endpoint": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "ollama": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "endpoint"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "endpoint": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "api": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "endpoint"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "endpoint": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "web": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "required",
            "endpoint"
          ],
          "properties": {
            "required": {
              "type": "boolean"
            },
            "endpoint": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "required_ollama_models": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation_stages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "preflight",
          "environment_safety",
          "static",
          "database",
          "infrastructure",
          "ai",
          "web_build",
          "live_preview",
          "security",
          "recovery",
          "evidence"
        ]
      }
    },
    "browser_viewports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "width",
          "height"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "width": {
            "type": "integer",
            "minimum": 320
          },
          "height": {
            "type": "integer",
            "minimum": 480
          }
        }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}

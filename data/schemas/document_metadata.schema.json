{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lecturer-support-agent.local/schemas/document_metadata.schema.json",
  "title": "Document Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document_id",
    "tenant_id",
    "title",
    "content_type",
    "language",
    "scope",
    "classification",
    "rights",
    "created_at"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "description": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 4000
    },
    "content_type": {
      "type": "string"
    },
    "mime_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organizational_unit_ids"
      ],
      "properties": {
        "organizational_unit_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "programme_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "module_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "academic_period": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "academic": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "discipline": {
          "type": [
            "string",
            "null"
          ]
        },
        "qualification_level": {
          "type": [
            "string",
            "null"
          ]
        },
        "pedagogies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "learning_outcomes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "duration_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "classification": {
      "$ref": "#/$defs/classification"
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "model_use"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "copyright_holder": {
          "type": [
            "string",
            "null"
          ]
        },
        "licence_identifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "terms_uri": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "model_use": {
          "type": "string"
        }
      }
    },
    "associations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assessment_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "review_assignment_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "conversation_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "effective_from": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "effective_to": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "maxLength": 100
      }
    }
  },
  "$defs": {
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidentiality",
        "personal_data",
        "assessment_security",
        "model_use"
      ],
      "properties": {
        "confidentiality": {
          "enum": [
            "C0_PUBLIC",
            "C1_INTERNAL",
            "C2_CONFIDENTIAL",
            "C3_HIGHLY_RESTRICTED"
          ]
        },
        "personal_data": {
          "enum": [
            "PD0_NONE",
            "PD1_BASIC_CONTACT",
            "PD2_EMPLOYMENT_ACADEMIC",
            "PD3_STUDENT_RECORD",
            "PD4_SPECIAL_HIGH_RISK"
          ]
        },
        "assessment_security": {
          "enum": [
            "AS0_NOT_ASSESSMENT",
            "AS1_PUBLIC_PRACTICE",
            "AS2_DRAFT_ASSESSMENT",
            "AS3_ACTIVE_SECURE_ASSESSMENT",
            "AS4_MARKING_SECRET",
            "AS5_RELEASED_ARCHIVE"
          ]
        },
        "model_use": {
          "enum": [
            "MODEL_NONE",
            "MODEL_RUNTIME_CONTEXT_ONLY",
            "MODEL_EVALUATION_ONLY",
            "MODEL_PROMPT_EXAMPLE_APPROVED",
            "MODEL_ADAPTATION_APPROVED"
          ]
        }
      }
    }
  }
}

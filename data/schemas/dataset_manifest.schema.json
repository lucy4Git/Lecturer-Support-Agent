{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lecturer-support-agent.local/schemas/dataset_manifest.schema.json",
  "title": "Dataset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_id",
    "name",
    "version",
    "owner",
    "source",
    "intended_uses",
    "licence",
    "classification",
    "quality",
    "created_at"
  ],
  "properties": {
    "dataset_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,127}$"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 240
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "authority"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "authority": {
          "type": "string"
        },
        "contact": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "uri",
        "acquired_at",
        "provenance_status"
      ],
      "properties": {
        "type": {
          "enum": [
            "institution",
            "open_repository",
            "scholarly_metadata",
            "expert_authored",
            "synthetic",
            "other"
          ]
        },
        "uri": {
          "type": "string",
          "format": "uri"
        },
        "snapshot_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "acquired_at": {
          "type": "string",
          "format": "date-time"
        },
        "provenance_status": {
          "enum": [
            "verified",
            "partial",
            "unverified"
          ]
        }
      }
    },
    "intended_uses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "discovery_metadata",
          "runtime_retrieval",
          "evaluation_only",
          "safety_testing_only",
          "prompt_examples",
          "model_adaptation",
          "analytics",
          "archive_only"
        ]
      }
    },
    "prohibited_uses": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "commercial_use",
        "derivatives",
        "verified_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "public_domain",
            "cc0",
            "cc_by",
            "share_alike",
            "noncommercial",
            "no_derivatives",
            "institution_owned",
            "permission_granted",
            "link_only",
            "unknown"
          ]
        },
        "identifier": {
          "type": [
            "string",
            "null"
          ]
        },
        "terms_uri": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "copyright_holder": {
          "type": [
            "string",
            "null"
          ]
        },
        "commercial_use": {
          "enum": [
            "allowed",
            "prohibited",
            "permission_required",
            "unknown"
          ]
        },
        "derivatives": {
          "enum": [
            "allowed",
            "share_alike",
            "prohibited",
            "unknown"
          ]
        },
        "attribution": {
          "type": [
            "string",
            "null"
          ]
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "classification": {
      "$ref": "#/$defs/classification"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "disciplines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "qualification_levels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "teaching_modalities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reviewed_by",
        "reviewed_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "quarantined",
            "sampled",
            "approved",
            "restricted",
            "rejected"
          ]
        },
        "score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "reviewed_by": {
          "type": "string"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contamination_checked": {
          "type": "boolean"
        }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "class": {
          "type": "string"
        },
        "retain_until": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "legal_hold": {
          "type": "boolean"
        }
      }
    },
    "checksums": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "algorithm",
          "value"
        ],
        "properties": {
          "algorithm": {
            "enum": [
              "sha256",
              "sha512"
            ]
          },
          "value": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]+$"
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "$defs": {
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "confidentiality",
        "personal_data",
        "assessment_security",
        "model_use"
      ],
      "properties": {
        "confidentiality": {
          "enum": [
            "C0_PUBLIC",
            "C1_INTERNAL",
            "C2_CONFIDENTIAL",
            "C3_HIGHLY_RESTRICTED"
          ]
        },
        "personal_data": {
          "enum": [
            "PD0_NONE",
            "PD1_BASIC_CONTACT",
            "PD2_EMPLOYMENT_ACADEMIC",
            "PD3_STUDENT_RECORD",
            "PD4_SPECIAL_HIGH_RISK"
          ]
        },
        "assessment_security": {
          "enum": [
            "AS0_NOT_ASSESSMENT",
            "AS1_PUBLIC_PRACTICE",
            "AS2_DRAFT_ASSESSMENT",
            "AS3_ACTIVE_SECURE_ASSESSMENT",
            "AS4_MARKING_SECRET",
            "AS5_RELEASED_ARCHIVE"
          ]
        },
        "model_use": {
          "enum": [
            "MODEL_NONE",
            "MODEL_RUNTIME_CONTEXT_ONLY",
            "MODEL_EVALUATION_ONLY",
            "MODEL_PROMPT_EXAMPLE_APPROVED",
            "MODEL_ADAPTATION_APPROVED"
          ]
        }
      }
    }
  }
}

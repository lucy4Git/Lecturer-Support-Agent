{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lecturer-support-agent.local/schemas/bulk_upload_manifest.schema.json",
  "title": "Bulk Upload Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "batch_id",
    "tenant_id",
    "actor",
    "target_scope",
    "defaults",
    "items",
    "created_at",
    "idempotency_key"
  ],
  "properties": {
    "manifest_version": {
      "const": "1.0"
    },
    "batch_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "user_id",
        "active_role"
      ],
      "properties": {
        "user_id": {
          "type": "string",
          "format": "uuid"
        },
        "active_role": {
          "type": "string"
        },
        "delegation_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      }
    },
    "target_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "organizational_unit_id"
      ],
      "properties": {
        "organizational_unit_id": {
          "type": "string",
          "format": "uuid"
        },
        "programme_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "module_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "visibility",
        "confidentiality",
        "rights_status",
        "model_use"
      ],
      "properties": {
        "academic_period": {
          "type": [
            "string",
            "null"
          ]
        },
        "visibility": {
          "enum": [
            "private",
            "module",
            "department",
            "programme",
            "institution",
            "public"
          ]
        },
        "confidentiality": {
          "enum": [
            "C0_PUBLIC",
            "C1_INTERNAL",
            "C2_CONFIDENTIAL",
            "C3_HIGHLY_RESTRICTED"
          ]
        },
        "rights_status": {
          "type": "string"
        },
        "model_use": {
          "type": "string"
        },
        "change_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "client_item_id",
          "path",
          "sha256",
          "size_bytes",
          "duplicate_decision"
        ],
        "properties": {
          "client_item_id": {
            "type": "string"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "content_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "overrides": {
            "type": "object"
          },
          "duplicate_decision": {
            "enum": [
              "pending",
              "link_existing",
              "new_version",
              "alternate",
              "new_item",
              "cancel"
            ]
          },
          "existing_version_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          }
        }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 200
    }
  }
}

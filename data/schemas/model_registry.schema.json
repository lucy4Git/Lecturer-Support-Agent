{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lecturer-support-agent.local/schemas/model_registry.schema.json",
  "title": "Model Registry",
  "type": "object",
  "required": [
    "registry_version",
    "generated_at",
    "aliases",
    "models",
    "cloud_models"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "registry_version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "routing_class",
          "allowed_providers"
        ],
        "properties": {
          "routing_class": {
            "type": "string"
          },
          "allowed_providers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "models": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "provider",
          "model_id",
          "deployment_type",
          "lifecycle",
          "capabilities",
          "approved_data_classes"
        ],
        "properties": {
          "provider": {
            "type": "string"
          },
          "model_id": {
            "type": "string"
          },
          "deployment_type": {
            "enum": [
              "cloud",
              "local",
              "self_hosted"
            ]
          },
          "lifecycle": {
            "enum": [
              "candidate",
              "approved",
              "restricted",
              "deprecated",
              "retired"
            ]
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "approved_data_classes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "cloud_models": {
      "type": "object"
    }
  },
  "additionalProperties": false
}

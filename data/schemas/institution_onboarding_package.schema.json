{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lecturer-support-agent.local/schemas/institution_onboarding_package.schema.json",
  "title": "Institution Onboarding Package",
  "type": "object",
  "required": ["format_version", "institution", "organisational_units", "academic_periods", "programmes", "modules", "users", "governance"],
  "properties": {
    "format_version": {"const": "1.0"},
    "institution": {
      "type": "object",
      "required": ["code", "name", "country_code", "timezone"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z0-9_-]{2,30}$"},
        "name": {"type": "string", "minLength": 2, "maxLength": 300},
        "country_code": {"type": "string", "pattern": "^[A-Z]{2}$"},
        "timezone": {"type": "string", "minLength": 3},
        "terminology": {"type": "object"}
      },
      "additionalProperties": false
    },
    "organisational_units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["external_id", "unit_type", "name"],
        "properties": {
          "external_id": {"type": "string", "minLength": 1},
          "parent_external_id": {"type": ["string", "null"]},
          "unit_type": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "code": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "academic_periods": {"type": "array", "items": {"type": "object", "required": ["external_id", "name", "starts_on", "ends_on"]}},
    "programmes": {"type": "array", "items": {"type": "object", "required": ["external_id", "name", "owning_unit_external_id"]}},
    "modules": {"type": "array", "items": {"type": "object", "required": ["external_id", "code", "title", "owning_unit_external_id"]}},
    "users": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["email", "given_name", "family_name", "roles"],
        "properties": {
          "email": {"type": "string", "format": "email"},
          "given_name": {"type": "string", "minLength": 1},
          "family_name": {"type": "string", "minLength": 1},
          "roles": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["code", "scope_type"]}}
        }
      }
    },
    "governance": {
      "type": "object",
      "required": ["data_owner", "approval_reference", "approved_at", "contains_personal_data"],
      "properties": {
        "data_owner": {"type": "string", "minLength": 2},
        "approval_reference": {"type": "string", "minLength": 2},
        "approved_at": {"type": "string", "format": "date-time"},
        "contains_personal_data": {"type": "boolean"},
        "retention_policy_reference": {"type": ["string", "null"]}
      }
    }
  },
  "additionalProperties": false
}

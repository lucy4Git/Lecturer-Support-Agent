{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lecturer-support-agent.local/schemas/institutional_structure.schema.json",
  "title": "Institutional Structure Import",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant",
    "unit_types",
    "units",
    "academic_entities",
    "effective_from"
  ],
  "properties": {
    "tenant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_id",
        "name",
        "code",
        "default_language"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "name": {
          "type": "string"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{2,32}$"
        },
        "jurisdictions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "default_language": {
          "type": "string"
        }
      }
    },
    "unit_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "label",
          "allowed_parent_keys",
          "allows_children"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,63}$"
          },
          "label": {
            "type": "string"
          },
          "plural_label": {
            "type": [
              "string",
              "null"
            ]
          },
          "allowed_parent_keys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "allows_children": {
            "type": "boolean"
          }
        }
      }
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit_id",
          "type_key",
          "code",
          "name",
          "status"
        ],
        "properties": {
          "unit_id": {
            "type": "string",
            "format": "uuid"
          },
          "type_key": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "parent_unit_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "status": {
            "enum": [
              "active",
              "inactive",
              "planned",
              "archived"
            ]
          },
          "effective_from": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "effective_to": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          }
        }
      }
    },
    "academic_entities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "programmes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/academicEntity"
          }
        },
        "qualifications": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/academicEntity"
          }
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/academicEntity"
          }
        }
      }
    },
    "terminology": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "effective_from": {
      "type": "string",
      "format": "date"
    },
    "source_system": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "academicEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "code",
        "name",
        "owning_unit_ids",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "code": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "owning_unit_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "level": {
          "type": [
            "string",
            "null"
          ]
        },
        "credits": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "status": {
          "enum": [
            "active",
            "inactive",
            "planned",
            "archived"
          ]
        }
      }
    }
  }
}

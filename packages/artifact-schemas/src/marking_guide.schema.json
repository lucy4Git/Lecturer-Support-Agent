{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lecturer-support-agent.local/schemas/marking_guide.schema.json",
  "title": "Marking Guide",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "items",
    "total_marks",
    "confidential",
    "human_review_required",
    "student_release_allowed"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "total_marks": {
      "type": "number",
      "minimum": 0
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "expected_answer",
          "marks"
        ],
        "properties": {
          "question_id": {
            "type": "string"
          },
          "expected_answer": {
            "type": "string"
          },
          "marks": {
            "type": "number",
            "minimum": 0
          },
          "marking_notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "confidential": {
      "const": true
    },
    "human_review_required": {
      "const": true
    },
    "student_release_allowed": {
      "const": false
    }
  }
}

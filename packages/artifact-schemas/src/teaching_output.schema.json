{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lecturer-support-agent.local/schemas/teaching_output.schema.json",
  "title": "Teaching Output",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "output_type",
    "title",
    "sections",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "output_type": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "heading",
          "content"
        ],
        "properties": {
          "heading": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string"
          },
          "required": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "module_context": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source_id",
          "title",
          "verified"
        ],
        "additionalProperties": true,
        "properties": {
          "source_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "verified": {
            "type": "boolean"
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": [
        "generated_by",
        "created_at"
      ],
      "additionalProperties": true,
      "properties": {
        "generated_by": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "model_provider": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_name": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lecturer-support-agent.local/schemas/assessment_package.schema.json",
  "title": "Assessment Package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_type",
    "title",
    "total_marks",
    "instructions",
    "questions",
    "human_review_required",
    "release_status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "assessment_type": {
      "enum": [
        "quiz",
        "test",
        "assignment",
        "examination",
        "practical_assessment",
        "oral_assessment",
        "project"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "total_marks": {
      "type": "integer",
      "minimum": 0
    },
    "duration_minutes": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "prompt",
          "marks"
        ],
        "properties": {
          "question_id": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "marks": {
            "type": "number",
            "minimum": 0
          },
          "learning_outcome_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cognitive_level": {
            "type": [
              "string",
              "null"
            ]
          },
          "answer": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "human_review_required": {
      "const": true
    },
    "release_status": {
      "enum": [
        "draft",
        "under_review",
        "changes_requested",
        "approved",
        "released",
        "archived"
      ]
    },
    "student_copy_safe": {
      "type": "boolean",
      "default": false
    },
    "safety_warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

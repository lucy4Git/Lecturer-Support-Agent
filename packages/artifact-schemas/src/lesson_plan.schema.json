{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lecturer-support-agent.local/schemas/lesson_plan.schema.json",
  "title": "Lesson Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "duration_minutes",
    "learning_outcomes",
    "lesson_sequence",
    "assessment"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "duration_minutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1440
    },
    "academic_level": {
      "type": [
        "string",
        "null"
      ]
    },
    "learning_outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lesson_sequence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "minutes",
          "lecturer_activity",
          "student_activity"
        ],
        "properties": {
          "phase": {
            "type": "string"
          },
          "minutes": {
            "type": "integer",
            "minimum": 0
          },
          "lecturer_activity": {
            "type": "string"
          },
          "student_activity": {
            "type": "string"
          }
        }
      }
    },
    "assessment": {
      "type": "string"
    },
    "inclusion_and_accessibility": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}

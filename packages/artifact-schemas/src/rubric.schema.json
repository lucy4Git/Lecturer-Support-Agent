{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lecturer-support-agent.local/schemas/rubric.schema.json",
  "title": "Rubric",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "title",
    "criteria",
    "total_marks",
    "human_review_required"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "rubric_type": {
      "enum": [
        "analytic",
        "holistic"
      ]
    },
    "total_marks": {
      "type": "number",
      "minimum": 0
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "weight",
          "levels"
        ],
        "properties": {
          "criterion": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0
          },
          "learning_outcome_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "levels": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "description",
                "score"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "score": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    },
    "human_review_required": {
      "const": true
    }
  }
}

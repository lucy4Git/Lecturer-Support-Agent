APP_NAME=Lecturer Support Agent
ENVIRONMENT=development
DEBUG=false
API_PREFIX=/api/v1
PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
DEVELOPMENT_HEADER_AUTH=false
EXPOSE_DEVELOPMENT_INVITATION_TOKENS=true

# Local infrastructure. Copy this file to .env and replace development passwords.
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=lecturer_support_agent
POSTGRES_OWNER_USER=lsa_owner
POSTGRES_OWNER_PASSWORD=change-owner-password
POSTGRES_APP_PASSWORD=change-app-password
POSTGRES_AUTH_PASSWORD=change-auth-password
POSTGRES_WORKER_PASSWORD=change-worker-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://lsa_app:change-app-password@localhost:5432/lecturer_support_agent
AUTH_DATABASE_URL=postgresql+psycopg://lsa_auth:change-auth-password@localhost:5432/lecturer_support_agent
MIGRATION_DATABASE_URL=postgresql+psycopg://lsa_owner:change-owner-password@localhost:5432/lecturer_support_agent
WORKER_DATABASE_URL=postgresql+psycopg://lsa_worker:change-worker-password@localhost:5432/lecturer_support_agent

REDIS_IMAGE=redis:7.4-alpine
REDIS_PASSWORD=change-redis-password
REDIS_PORT=6379
REDIS_URL=redis://:change-redis-password@localhost:6379/0

MINIO_IMAGE=minio/minio:latest
MINIO_CLIENT_IMAGE=minio/mc:latest
MINIO_ROOT_USER=lsa-development
MINIO_ROOT_PASSWORD=change-minio-password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_ACCESS_KEY=lsa-development
OBJECT_STORAGE_SECRET_KEY=change-minio-password
OBJECT_STORAGE_BUCKET=lecturer-support-agent
OBJECT_STORAGE_SECURE=false

QDRANT_IMAGE=qdrant/qdrant:v1.12.5
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=lecturer_support_documents

JWT_ISSUER=lecturer-support-agent
JWT_AUDIENCE=lecturer-support-agent-api
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=replace-with-at-least-32-random-bytes
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
INVITATION_EXPIRY_HOURS=72
PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_MIXED_CLASSES=true
MAXIMUM_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# Multi-provider AI gateway. Never commit real keys.
AI_ROUTING_MODE=capability_policy_router
AI_PROVIDER_REGISTRY_PATH=config/ai/providers.example.json
AI_MODEL_REGISTRY_PATH=config/ai/model-registry.example.json
MODEL_REGISTRY_REFRESH_HOURS=24
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_DEFAULT_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_DEFAULT_MODEL=
GOOGLE_GEMINI_API_KEY=
GOOGLE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GOOGLE_GEMINI_DEFAULT_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_DEFAULT_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe
SOURCE_SEARCH_PROVIDER=
SOURCE_SEARCH_API_KEY=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# v1.5 unified AI conversation engine. Keys remain blank in the repository.
AI_DEFAULT_PROVIDER=auto
AI_FALLBACK_ORDER=ollama,anthropic,openai,google_gemini,deepseek
AI_REQUEST_TIMEOUT_SECONDS=90
AI_MAX_OUTPUT_TOKENS=4096
AI_TEMPERATURE=0.2
AI_ENABLE_DEVELOPMENT_MOCK=true
AI_REQUIRE_LOCAL_FOR_RESTRICTED=true
AI_MAX_CONVERSATION_MESSAGES=24
ANTHROPIC_API_VERSION=2023-06-01
SOURCE_DISCOVERY_ENABLED=true
CROSSREF_BASE_URL=https://api.crossref.org
CROSSREF_CONTACT_EMAIL=
SOURCE_DISCOVERY_MAX_RESULTS=5
SOURCE_HTTP_TIMEOUT_SECONDS=15

# v1.6 ingestion, chunking, embeddings, and authorised retrieval
INGESTION_AUTO_PROCESS_UPLOADS=true
INGESTION_CHUNK_CHARACTERS=3200
INGESTION_CHUNK_OVERLAP_CHARACTERS=320
INGESTION_MAX_ARCHIVE_ENTRIES=500
INGESTION_MAX_ARCHIVE_UNCOMPRESSED_BYTES=2147483648
INGESTION_MAX_ARCHIVE_MEMBER_BYTES=1073741824
EMBEDDING_PROVIDER=ollama
EMBEDDING_DIMENSION=768
EMBEDDING_TIMEOUT_SECONDS=120
RETRIEVAL_MAX_CHUNKS=6
RETRIEVAL_MAX_EXCERPT_CHARACTERS=2200

# v1.7 teaching output, assessment safety, and export controls
OUTPUT_MAX_EDIT_CHARACTERS=500000
EXPORT_MAX_BYTES=52428800
EXPORT_ALLOWED_FORMATS=markdown,html,docx,pdf,pptx,xlsx
ASSESSMENT_REQUIRE_MODULE_CONTEXT_FOR_RELEASE=true
ASSESSMENT_BLOCK_STUDENT_COPY_WITH_ANSWERS=true

# v2.3 production hardening, observability, malware scanning, and durable jobs
LOG_LEVEL=INFO
JSON_LOGS=true
TRUSTED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
MAXIMUM_REQUEST_BYTES=1126170624
RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=240
AUTH_RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_FAIL_CLOSED=false
METRICS_ENABLED=true
METRICS_TOKEN=
READINESS_PROBE_TIMEOUT_SECONDS=5
READINESS_REQUIRE_OLLAMA=false
MALWARE_SCAN_ENABLED=false
MALWARE_SCAN_FAIL_CLOSED=false
MALWARE_SCAN_TIMEOUT_SECONDS=30
CLAMAV_HOST=localhost
CLAMAV_PORT=3310
BACKGROUND_WORKER_POLL_SECONDS=2
BACKGROUND_JOB_LEASE_SECONDS=120

# v2.5 account recovery, MFA, SSO, email and enterprise integration
PASSWORD_RESET_EXPIRY_MINUTES=30
EMAIL_VERIFICATION_EXPIRY_HOURS=24
MFA_TOTP_ISSUER=Lecturer Support Agent
MFA_TOTP_PERIOD_SECONDS=30
MFA_TOTP_DIGITS=6
MFA_RECOVERY_CODE_COUNT=10
MFA_SECRET_ENCRYPTION_KEY=
MESSAGE_CONTENT_ENCRYPTION_KEY=
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=no-reply@example.invalid
EMAIL_FROM_NAME=Lecturer Support Agent
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_STARTTLS=false
OIDC_HTTP_TIMEOUT_SECONDS=20
OIDC_STATE_EXPIRY_MINUTES=10
INTEGRATION_HTTP_TIMEOUT_SECONDS=60
INTEGRATION_MAX_RECORDS_PER_SYNC=10000
OUTBOUND_HTTP_ALLOW_INSECURE=false
OUTBOUND_HTTP_ALLOW_PRIVATE_NETWORKS=false
OUTBOUND_HTTP_ALLOWED_HOSTS=

# Provider credentials referenced by tenant integration configuration; keep values local.
CANVAS_API_TOKEN=
MOODLE_API_TOKEN=
ONEROSTER_CLIENT_SECRET=
ENTRA_CLIENT_SECRET=
GOOGLE_WORKSPACE_CLIENT_SECRET=

# v2.5 source discovery, rights gating, deletion and backup execution
OPENALEX_ENABLED=true
OPENALEX_BASE_URL=https://api.openalex.org
OPENALEX_API_KEY=
OPENALEX_CONTACT_EMAIL=
SOURCE_CLAIM_VERIFICATION_REQUIRED_FOR_HIGH_STAKES=true
DELETION_REQUIRE_SECOND_APPROVER=true
DELETION_ALLOW_HARD_DELETE=false
LEGAL_HOLD_DEFAULT_REVIEW_DAYS=365
BACKUP_ROOT_PATH=runtime/backups
PG_DUMP_EXECUTABLE=pg_dump
PG_RESTORE_EXECUTABLE=pg_restore
BACKUP_COMPONENT_TIMEOUT_SECONDS=600
BACKUP_STORAGE_ENCRYPTION_ATTESTED=false
RESTORE_DRILL_EXECUTABLE=
